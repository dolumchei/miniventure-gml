function singleton_Color() constructor
{
	precomputedColor = PrecomputedColors();
	
	get = function(a, b, c, d)
	{
		return [ a, b, c, d ];
		
		if (!is_undefined(a) && !is_undefined(b) && !is_undefined(c) && !is_undefined(d))
			return getArray(a, b, c, d);
		if (!is_undefined(a) && is_undefined(b) && is_undefined(c) && is_undefined(d))
		{
			var seperated = seperateBit(a);
			return getArray(seperated[0], seperated[1], seperated[2], seperated[3]);
		}
	}
	
	getArray = function(a, b, c, d)
	{
	    var color_a = getComponent(a);
	    var color_b = getComponent(b);
	    var color_c = getComponent(c);
	    var color_d = getComponent(d);
	
		var color_array = 
		[
			[ color_a[0], color_a[1], color_a[2], color_a[3] ],
			[ color_b[0], color_b[1], color_b[2], color_b[3] ],
			[ color_c[0], color_c[1], color_c[2], color_c[3] ],
			[ color_d[0], color_d[1], color_d[2], color_d[3] ]
		];
		
		return color_array;
	}
	getComponent = function(d)
	{
	    if (d < 0) 
			return [ 1, 1, 1, 0 ];
		if (precomputedColor[d] != undefined)
			return precomputedColor[d];
			
	    var r = floor(d / 100) % 10;
	    var g = floor(d / 10) % 10;
	    var b = d % 10;
	
	    var rr = r * 255 / 5;
	    var gg = g * 255 / 5;
	    var bb = b * 255 / 5;
	
	    var mid = floor((rr * 30 + gg * 59 + bb * 11) / 100);
	    var r1 = (floor((rr + mid) / 2) * 230 / 255 + 10) / 255;
	    var g1 = (floor((gg + mid) / 2) * 230 / 255 + 10) / 255;
	    var b1 = (floor((bb + mid) / 2) * 230 / 255 + 10) / 255;
		
		precomputedColor[d] = [ r1, g1, b1, 1 ];
	
	    return precomputedColor[d];
	}	
	seperateBit = function(v)
	{
		var a = (v >> 24) & 0xFF;
		var b = (v & 0x00_FF_00_00) >> 16;
		var c = (v & 0x00_00_FF_00) >> 8;
		var d = (v & 0x00_00_00_FF);

		return [ a, b, c, d ];
	}	
	
	getSingle = function(a, b, c, d)
	{
		return (getSingleComponent(d) << 24) + (getSingleComponent(c) << 16) + (getSingleComponent(b) << 8) + (getSingleComponent(a));
	}

	getSingleComponent = function(d)
	{
		if (d < 0)
			return 255;
		var r = d / 100 % 10;
		var g = d / 10 % 10;
		var b = d % 10;
		return r * 36 + g * 6 + b;
	}
}